# Leave empty in dev (Vite proxies /api to http://localhost:5001).
# In production set to the API origin on the same site, e.g. https://api.manushyam.com
VITE_API_URL=
VITE_APP_URL=http://localhost:5173
# Cloudflare Turnstile site key for the contact form (leave empty in dev; pair with TURNSTILE_SECRET_KEY on the API)
VITE_TURNSTILE_SITE_KEY=
# Production only: "netlify" resizes bundled /images through Netlify Image CDN (Cloudinary images are always optimised)
VITE_IMAGE_CDN=
# Shown with browser crash reports (e.g. the git commit); optional
VITE_RELEASE=
