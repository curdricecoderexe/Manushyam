# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5001
# Local MongoDB (Homebrew). It must run as a replica set (orders use transactions) — see the README.
MONGODB_URI=mongodb://localhost:27017/manushyam?replicaSet=rs0
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
GLOBAL_RATE_MAX=300
AUTH_RATE_MAX=20
OTP_RATE_MAX=10
# Analytics ingest: requests per minute / per day from one IP; raw analytics kept this many days (daily totals are kept).
ANALYTICS_RATE_MAX=60
ANALYTICS_DAILY_MAX=2000
ANALYTICS_RETENTION_DAYS=90
APP_URL=http://localhost:5173
# Require an emailed code at customer login (always on for staff/admin)
CUSTOMER_LOGIN_OTP=true
# Outgoing email through Gmail SMTP. Leave SMTP_USER and SMTP_PASS empty in dev to print emails to the API log.
# SMTP_USER: the Gmail address that sends the mail.
# SMTP_PASS: a 16-character App Password — turn on 2-Step Verification, then create one at
#            https://myaccount.google.com/apppasswords (your normal Gmail password will not work).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Gmail always sends from SMTP_USER; only the display name here is kept.
MAIL_FROM="ManushyaM <no-reply@manushyam.com>"

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_PEPPER=

# Product/CMS image uploads (leave empty to disable; the upload endpoint then returns 503)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (prepaid). Leave the three keys empty to offer Cash on Delivery only.
# Keys: Dashboard → Account & Settings → API Keys (rzp_test_ locally, rzp_live_ in production).
# Webhook: Dashboard → Account & Settings → Webhooks → Add
#   URL:    https://<api-host>/api/webhooks/razorpay
#   Secret: a long random value (generate like the JWT secrets) → RAZORPAY_WEBHOOK_SECRET
#   Events: payment.authorized, payment.captured, payment.failed, order.paid,
#           refund.processed, refund.failed, payment.dispute.created
# Payment capture: Account & Settings → Capture settings → Automatic (recommended). Authorised-only
# payments are captured by the webhook / cron anyway. The /api/cron/cleanup job also re-checks unpaid
# orders with Razorpay before expiring them, so a missed webhook doesn't cancel a paid order.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: merchant account id (acc_…). Webhooks carrying another account_id are ignored.
RAZORPAY_ACCOUNT_ID=
# Refund paid online orders automatically when they are cancelled.
RAZORPAY_AUTO_REFUND_ON_CANCEL=true
# normal (free, 5–7 working days) | optimum (instant where the bank supports it; Razorpay charges a fee)
RAZORPAY_REFUND_SPEED=normal
# NODE_ENV=production refuses rzp_test_ keys unless this is true (staging only).
RAZORPAY_ALLOW_TEST_MODE=false

# Shiprocket. Leave SHIPROCKET_EMAIL empty to quote delivery from the admin PIN rules and enter AWBs manually.
# Credentials: a dedicated API user (Shiprocket → Settings → API → Configure → Create an API User).
# Pickup: the exact nickname of a pickup address (Settings → Pickup Addresses) and its PIN code.
# Tracking webhook (Settings → API → Webhooks):
#   URL:   https://<api-host>/api/webhooks/shipping   (Shiprocket rejects URLs containing "shiprocket")
#   Token: SHIPROCKET_WEBHOOK_TOKEN (sent as x-api-key; generate like the JWT secrets)
# Box sizes are managed in Admin → Box sizes; their dimensions and weight are sent with every shipment.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PIN=560001
SHIPROCKET_WEBHOOK_TOKEN=
# Optional: the channel to file orders under, and a fixed courier (courier_company_id; empty = Shiprocket's recommendation).
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_COURIER_ID=
# Request the courier pickup as soon as the AWB is assigned (false = schedule pickups in Shiprocket).
SHIPROCKET_AUTO_PICKUP=true

# Render Cron: POST /api/cron/cleanup every 5 min, POST /api/cron/sync-shipments hourly,
# both with header x-cron-secret. Generate like the JWT secrets.
CRON_SECRET=

# GST invoice details (confirm with the owner before launch)
INVOICE_LEGAL_NAME="ManushyaM Wellness Pvt. Ltd."
INVOICE_ADDRESS="Bengaluru, Karnataka, India"
INVOICE_GSTIN=
INVOICE_STATE=Karnataka
GST_RATE_PERCENT=18

# Contact form: messages go to SUPPORT_EMAIL. Turnstile secret pairs with FE VITE_TURNSTILE_SITE_KEY
# (leave empty in dev — the honeypot and rate limit still apply).
SUPPORT_EMAIL=care@manushyam.com
TURNSTILE_SECRET_KEY=

# Live chat + notification push run on Socket.IO at /socket.io on the API host.
# Set REDIS_URL when running more than one API instance so they share rooms (Upstash/Redis).
REDIS_URL=
