# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://localhost:27018/manushyam?replicaSet=rs0&directConnection=true
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
GLOBAL_RATE_MAX=300
AUTH_RATE_MAX=20
OTP_RATE_MAX=10
# Analytics ingest: requests per minute / per day from one IP; raw analytics kept this many days (daily totals are kept).
ANALYTICS_RATE_MAX=60
ANALYTICS_DAILY_MAX=2000
ANALYTICS_RETENTION_DAYS=90
APP_URL=http://localhost:5173
# Require an emailed code at customer login (always on for staff/admin)
CUSTOMER_LOGIN_OTP=true
# Leave empty in dev to print emails to the log; use Mailpit: smtp://localhost:1025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="ManushyaM <no-reply@manushyam.com>"

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_PEPPER=

# Product/CMS image uploads (leave empty to disable; the upload endpoint then returns 503)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (prepaid). Leave all three empty to offer Cash on Delivery only.
# Webhook URL: https://<api-host>/api/webhooks/razorpay  (events: payment.captured, payment.failed, refund.processed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket. Leave empty to quote delivery from the admin PIN rules and enter AWBs manually.
# Tracking webhook URL: https://<api-host>/api/webhooks/shipping  (token = SHIPROCKET_WEBHOOK_TOKEN)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PIN=560001
SHIPROCKET_WEBHOOK_TOKEN=

# Render Cron: POST /api/cron/cleanup every 5 min, POST /api/cron/sync-shipments hourly,
# both with header x-cron-secret. Generate like the JWT secrets.
CRON_SECRET=

# GST invoice details (confirm with the owner before launch)
INVOICE_LEGAL_NAME="ManushyaM Wellness Pvt. Ltd."
INVOICE_ADDRESS="Bengaluru, Karnataka, India"
INVOICE_GSTIN=
INVOICE_STATE=Karnataka
GST_RATE_PERCENT=18

# Contact form: messages go to SUPPORT_EMAIL. Turnstile secret pairs with FE VITE_TURNSTILE_SITE_KEY
# (leave empty in dev — the honeypot and rate limit still apply).
SUPPORT_EMAIL=care@manushyam.com
TURNSTILE_SECRET_KEY=

# Live chat + notification push run on Socket.IO at /socket.io on the API host.
# Set REDIS_URL when running more than one API instance so they share rooms (Upstash/Redis).
REDIS_URL=
